# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Large / regenerated data (README rebuilds these). Self-sourced images (own_*.jpg) are whitelisted --
# they have no image_source_url to rebuild from (they're not scraped from anywhere), so unlike every
# other catalogue image they must be committed or a clean checkout can never build the index.
data/catalogue/images/*
!data/catalogue/images/own_*.jpg
data/index/
data/index_crop/
*.faiss
*.npy

# macOS
.DS_Store

# Claude Code session-local state
.claude/scheduled_tasks.lock

# Brief (kept locally)
*.pdf
